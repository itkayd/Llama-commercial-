{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/quote",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quote/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/:slug/:rest*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/404.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
