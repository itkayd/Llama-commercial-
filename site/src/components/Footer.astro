---
import { site, telHref, mailHref } from '../config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo id="footer" />
      <p class="muted">Commercial cleaning across London. Based in Hackney.</p>
      <p class="tagline">{site.tagline}</p>
    </div>

    <nav class="footer-col" aria-labelledby="footer-company">
      <h2 class="footer-title" id="footer-company">Company</h2>
      <ul role="list">
        <li><a href="/about/">About us</a></li>
        <li><a href="/areas/">Areas covered</a></li>
        <li><a href="/contact/">Contact us</a></li>
        <li><a href="/privacy/">Privacy notice</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-labelledby="footer-services">
      <h2 class="footer-title" id="footer-services">Services</h2>
      <ul role="list">
        <li><a href="/services/regular-office-cleaning/">Contract cleaning</a></li>
        <li><a href="/services/#floors">Floors and carpets</a></li>
        <li><a href="/services/deep-cleaning/">Deep cleaning</a></li>
        <li><a href="/services/car-park-cleaning/">Car parks</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-title">Contact</h2>
      <ul role="list">
        <li><a class="num" href={telHref}>{site.phoneDisplay}</a></li>
        <li><a href={mailHref}>{site.email}</a></li>
        <li class="muted hours">{site.hours}</li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>
      © {year} {site.legalName} · Registered in England and Wales · Company no. {site.companyNumber} · Registered office: {
        site.registeredOffice
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--card);
    border-top: 1px solid var(--line);
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: max(24px, env(safe-area-inset-bottom));
  }
  .footer-grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: auto;
    }
  }
  .footer-brand {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
  }
  .footer-brand p {
    font-size: 16px;
  }
  .footer-col {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .footer-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.3;
  }
  .footer-col ul {
    display: grid;
    gap: 0;
    font-size: 16px;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-color: var(--line);
    overflow-wrap: anywhere;
  }
  .footer-col a:hover {
    text-decoration-color: currentColor;
  }
  .hours {
    padding-top: 10px;
    font-size: 15px;
    line-height: 1.5;
  }
  .legal {
    margin-top: var(--space-5);
  }
  .legal p {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
