---
import { SITE, telHref } from '../config';
import Logo from './Logo.astro';
import { nav } from '../nav';

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="phone" href={telHref}><span class="visually-hidden">Call </span>{SITE.phone}</a>
    <a class="call-btn" href={telHref} aria-label="Call us">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 006.2 6.2l1.4-2.1 4.2 1.6V18a2.5 2.5 0 01-2.5 2.5A15.5 15.5 0 012.5 6 2.5 2.5 0 015 3.5z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (button && header) {
    button.hidden = false;
    const setOpen = (open: boolean, focusButton = false) => {
      button.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      if (focusButton) button.focus();
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    header.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 820px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top);
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px 20px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2px;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    padding: 8px 11px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 15.5px;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .nav a:hover {
    background: var(--soft);
  }
  /* The span is exactly as wide as the text, so the zigzag under it is too. */
  .nav a span {
    position: relative;
    display: inline-block;
  }
  .nav a[aria-current='page'] {
    color: var(--active);
    font-weight: 700;
  }
  .nav a[aria-current='page'] span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 8px;
    background: var(--zigzag-small) left top / 12px 8px repeat-x;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .phone:hover {
    text-decoration: underline;
  }
  .call-btn,
  .menu-btn {
    display: none;
  }

  @media (max-width: 819.98px) {
    .bar {
      flex-wrap: wrap;
      gap: 10px;
    }
    .phone {
      display: none;
    }
    .call-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 40px;
      margin-left: auto;
      border-radius: 8px;
      background: var(--brand);
    }
    .menu-btn:not([hidden]) {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 8px 14px;
      border: 1.5px solid var(--line);
      border-radius: 8px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-weight: 600;
      font-size: 15.5px;
      cursor: pointer;
    }
    .nav {
      order: 10;
      flex-basis: 100%;
      margin-left: 0;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav li + li {
      border-top: 1px solid var(--line);
    }
    .nav a {
      display: flex;
      padding: 12px 4px;
      border-radius: 0;
      font-size: 17px;
    }
    /* Without JavaScript the list stays visible; with it, the Menu button opens it. */
    :global(html.js) .nav {
      display: none;
    }
    :global(html.js) .is-open .nav {
      display: block;
    }
  }
  /* Keep logo, call and Menu on one row on the narrowest phones. */
  @media (max-width: 359.98px) {
    .bar {
      gap: 8px;
    }
    .menu-btn:not([hidden]) {
      padding: 8px 10px;
    }
  }
</style>
