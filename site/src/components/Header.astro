---
import { site, telHref } from '../config';
import Logo from './Logo.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About Us' },
  { href: '/services/', label: 'Services' },
  { href: '/areas/', label: 'Areas Covered' },
  { href: '/contact/', label: 'Contact Us' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="bar">
    <Logo id="header" />
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="phone" href={telHref}><span class="visually-hidden">Call </span>{site.phoneDisplay}</a>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (button && header) {
    button.hidden = false;
    const setOpen = (open: boolean, focusButton = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
      header.classList.toggle('is-open', open);
      if (focusButton) button.focus();
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    window.matchMedia('(min-width: 820px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--page);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: 1000px;
    margin-inline: auto;
    padding: 12px max(20px, env(safe-area-inset-right)) 12px max(20px, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px 24px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 4px 22px;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    font-size: 15.5px;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  .nav a[aria-current='page'] {
    color: var(--active);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--saffron);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .phone:hover {
    text-decoration: underline;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 819.98px) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo button'
        'phone phone'
        'nav nav';
      gap: 4px 16px;
    }
    .bar > :global(.logo) {
      grid-area: logo;
    }
    .menu-btn:not([hidden]) {
      grid-area: button;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 8px 18px;
      border: 1.5px solid var(--line);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-weight: 700;
      font-size: 15.5px;
      cursor: pointer;
    }
    .phone {
      grid-area: phone;
      justify-self: start;
    }
    .nav {
      grid-area: nav;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav li {
      border-top: 1px solid var(--line);
    }
    .nav a {
      display: flex;
      font-size: 17px;
    }
    /* With JavaScript the list is hidden until the Menu button opens it. */
    :global(html.js) .nav {
      display: none;
    }
    :global(html.js) .is-open .nav {
      display: block;
    }
  }
</style>
