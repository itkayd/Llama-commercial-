---
import Icon from './Icon.astro';
import { site, telHref, mailHref } from '../config';
---
<ul class="ways" role="list">
  <li>
    <a class="card way" href={telHref}>
      <Icon name="phone" />
      <span class="way-label">Call us</span>
      <span class="way-phone num">{site.phoneDisplay}</span>
      <span class="way-note">{site.hours}</span>
    </a>
  </li>
  <li>
    <a class="card way" href={mailHref}>
      <Icon name="email" />
      <span class="way-label">Email us</span>
      <span class="way-email">{site.email}</span>
      <span class="way-note">Tell us about the building and what you need.</span>
    </a>
  </li>
</ul>

<style>
  .ways {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ways li {
    display: grid;
  }
  .way {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .way:hover {
    border-color: var(--highland);
    box-shadow: inset 0 0 0 1px var(--highland);
  }
  @media (prefers-color-scheme: dark) {
    .way:hover {
      border-color: var(--on-brand-muted);
      box-shadow: inset 0 0 0 1px var(--on-brand-muted);
    }
  }
  .way :global(.icon) {
    margin-bottom: 10px;
  }
  .way-label {
    font-weight: 700;
    font-size: 15.5px;
    color: var(--ink-muted);
  }
  .way-phone {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.2;
  }
  .way-email {
    font-weight: 700;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .way-phone,
  .way-email {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .way:hover .way-phone,
  .way:hover .way-email {
    text-decoration-color: currentColor;
  }
  .way-note {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
