---
import { SITE } from '../config';
interface Props {
  variant?: 'navy' | 'white';
  size?: number;
}
const { variant = 'navy', size = 42 } = Astro.props;
const symbol = variant === 'white' ? 'llama-w' : 'llama';
---
<a class:list={['logo', `logo--${variant}`]} href="/" aria-label={`${SITE.name}, home`} style={`--logo-size:${size}px`}>
  <svg class="logo-icon" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href={`#${symbol}`} /></svg>
  <span class="logo-words" aria-hidden="true">
    <span class="logo-name">Llama</span>
    <span class="logo-sub">Commercial</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    border-radius: 8px;
    min-height: 40px;
  }
  .logo-icon {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }
  .logo-words {
    display: grid;
    gap: 3px;
  }
  .logo-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    line-height: 1;
  }
  .logo-sub {
    font-weight: 700;
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo--white {
    color: var(--brand-ink);
  }
  .logo--white .logo-sub {
    color: var(--brand-muted);
  }
  @media (max-width: 359.98px) {
    .logo--navy .logo-icon {
      width: 38px;
      height: 38px;
    }
    .logo--navy .logo-name {
      font-size: 20px;
    }
  }
</style>
