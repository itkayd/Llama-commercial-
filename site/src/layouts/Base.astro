---
import '../styles/global.css';
import { site, openingHoursSchema, isPlaceholder } from '../config';
import { services } from '../data/services';
import { allAreas } from '../data/areas';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import frauncesUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import manropeUrl from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImage = new URL('/brand/og.png', site.domain).href;
const logoUrl = new URL('/brand/llama-commercial-icon-512.png', site.domain).href;

const localBusiness: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.domain}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.domain}/`,
  telephone: site.phoneE164,
  email: site.email,
  logo: logoUrl,
  image: ogImage,
  slogan: site.tagline,
  openingHours: openingHoursSchema,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Greater London' },
    ...allAreas.map((a) => ({ '@type': 'Place', name: `${a.code} postcode area (${a.name})` })),
  ],
  makesOffer: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: s.h1,
      description: s.description,
      url: `${site.domain}/services/${s.slug}/`,
    },
  })),
};

if (!isPlaceholder(site.registeredOffice)) {
  localBusiness.address = {
    '@type': 'PostalAddress',
    streetAddress: site.registeredOffice,
    addressCountry: 'GB',
  };
}

const jsonLd = [localBusiness, ...schema];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#173D36" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Llama Commercial logo. Commercial cleaning across London. No drama. Just Llama." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
