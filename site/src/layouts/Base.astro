---
import '../styles/global.css';
import { SITE, telHref } from '../config';
import LogoSprite from '../components/LogoSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import manropeUrl from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** The 404 page: no canonical URL (hosts already serve it with a 404 status). */
  noindex?: boolean;
}

const { title, description, heading, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/brand/og.png', SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HouseAndOfficeCleaningService',
  name: SITE.name,
  telephone: telHref.replace('tel:', ''),
  email: SITE.email,
  url: `${SITE.url}/`,
  areaServed: SITE.area,
  logo: new URL('/brand/llama-commercial-icon-512.png', SITE.url).href,
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1F3A5F" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body>
    <LogoSprite />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <div class="title-band">
        <div class="wrap"><h1>{heading}</h1></div>
      </div>
      <div class="collar" aria-hidden="true"></div>
      <div class="wrap content">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
