---
import Base from '../layouts/Base.astro';
import { SITE, telHref } from '../config';
---
<Base
  title="Llama Commercial"
  heading="No drama. Just Llama."
  description="Commercial cleaning across Greater London for offices, schools, churches, shops, gyms, factories, communal areas and car parks."
>
  <section class="block">
    <h2>Clean buildings, quietly done</h2>
    <p>
      Offices, schools, churches, shops, gyms, factories, stairwells and car parks. If people work, learn, pray, train or park
      there, Llama can clean it.
    </p>
  </section>
  <section class="block">
    <h2>All over London</h2>
    <p>
      We work across Greater London, before you open, after you close, or around you during the day. Weekly, daily or just the
      once.
    </p>
  </section>
  <section class="block">
    <h2>Start with a walk-round</h2>
    <p>
      We come and look at the building, ask what matters to you, then put the price and the plan in writing. Then it's up to you.
      Call <a class="strong-link" href={telHref}>{SITE.phone}</a>.
    </p>
  </section>
</Base>
