---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { site, telHref } from '../config';
import { regular, formatPounds } from '../lib/pricing';

const buildingTypes = [
  'Office or business unit',
  'School or education centre',
  'Church or place of worship',
  'Shop',
  'Gym or sports facility',
  'Factory or warehouse (welfare and office areas)',
  'Communal areas',
];
const visitOptions = [1, 2, 3, 5, 7];

// Server-rendered defaults so the panel is right before (and without) JavaScript.
const initial = regular(1500, 2, 1, 5);
---
<Base
  title="Cleaning Price Estimate · Llama Commercial"
  description="A guide price for regular or one-off commercial cleaning in London. Enter your floor area, washrooms, kitchens and visits per week."
>
  <section class="page-head band--page">
    <div class="wrap">
      <Eyebrow>Price estimate</Eyebrow>
      <h1>Estimate your cleaning cost.</h1>
      <p class="lede">
        For offices, schools, churches, shops, gyms, factories and communal areas across London. Enter the building and see a guide
        price.
      </p>
    </div>
  </section>

  <section class="band band--page estimate-band">
    <div class="wrap estimate">
      <form class="card estimate-form" id="estimate" novalidate>
        <div class="field">
          <label for="building">Type of building</label>
          <select class="input" id="building" name="building">
            {buildingTypes.map((b) => <option>{b}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="sqft">Floor area to clean (sq ft)</label>
          <input class="input num" id="sqft" name="sqft" type="number" inputmode="numeric" min="0" max="50000" step="50" value="1500" aria-describedby="sqft-hint" />
          <label class="visually-hidden" for="sqft-range">Floor area slider (sq ft)</label>
          <input class="range" id="sqft-range" type="range" min="200" max="10000" step="50" value="1500" aria-describedby="sqft-hint" />
          <p class="hint" id="sqft-hint">Not sure? A 10-desk office is roughly 1,000 to 1,500 sq ft.</p>
        </div>

        <fieldset class="field segmented-field">
          <legend class="label">Type of clean</legend>
          <div class="segmented">
            <label><input type="radio" name="kind" value="regular" checked /><span>Regular contract</span></label>
            <label><input type="radio" name="kind" value="deep" /><span>One-off deep clean</span></label>
          </div>
        </fieldset>

        <fieldset class="field segmented-field" id="visits-field">
          <legend class="label">Visits per week</legend>
          <div class="segmented">
            {
              visitOptions.map((n) => (
                <label>
                  <input type="radio" name="visits" value={n} checked={n === 5} />
                  <span>{n}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="pair">
          <div class="field">
            <label for="washrooms">Toilets and washrooms</label>
            <input class="input num" id="washrooms" name="washrooms" type="number" inputmode="numeric" min="0" max="50" step="1" value="2" />
          </div>
          <div class="field">
            <label for="kitchens">Kitchens and break areas</label>
            <input class="input num" id="kitchens" name="kitchens" type="number" inputmode="numeric" min="0" max="20" step="1" value="1" />
          </div>
        </div>
      </form>

      <div class="side">
        <section class="result on-brand" aria-labelledby="result-label">
          <div aria-live="polite" aria-atomic="true" class="result-live">
            <p class="mono result-label" id="result-label">Estimated monthly price</p>
            <p class="result-price num">
              <span id="result-price">{formatPounds(initial.monthly)}</span><span class="per" id="result-per"> /month</span>
            </p>
            <dl class="result-rows" id="result-rows">
              <div><dt>Time per visit</dt><dd class="num">{initial.hours.toFixed(1)} hours</dd></div>
              <div><dt>Price per visit</dt><dd class="num">{formatPounds(initial.perVisit)}</dd></div>
              <div><dt>Visits</dt><dd class="num">5 a week</dd></div>
              <div><dt>Works out at</dt><dd class="num">£{initial.perSqft.toFixed(2)} per sq ft a month</dd></div>
            </dl>
          </div>
          <p class="result-note">A guide price. We confirm the final price in writing after a site visit.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="band band--card">
    <div class="wrap grid-2 below">
      <section class="card card--sage stack" aria-labelledby="floors-title">
        <h2 class="card-title" id="floors-title">Floors, carpets and car parks</h2>
        <p class="muted">
          Carpet and upholstery cleaning, floor scrubbing, stripping, sealing and polishing, and car park cleaning depend on the
          floor and its condition, so we price them after a site visit.
        </p>
      </section>

      <section class="card stack" aria-labelledby="talk-title">
        <h2 class="card-title" id="talk-title">Talk to us about your building</h2>
        <p class="muted">Site visits and written quotes are free.</p>
        <p class="talk-phone num" id="talk-phone">{site.phoneDisplay}</p>
        <div class="row">
          <button class="btn btn--ghost" type="button" id="copy-phone" data-phone={site.phoneDisplay}>Copy number</button>
          <a class="btn btn--primary" href={telHref}>Call<span class="visually-hidden"> {site.phoneDisplay}</span></a>
          <span class="visually-hidden" id="copy-status" aria-live="polite"></span>
        </div>
        <ul class="trust" role="list">
          <li class="chip">Insured</li>
          <li class="chip">Vetted staff</li>
          <li class="chip">Written specification</li>
        </ul>
        <p class="tagline">{site.tagline}</p>
      </section>
    </div>
  </section>
</Base>

<script>
  import { regular, deep, clampInput, LIMITS, formatPounds, formatNumber } from '../lib/pricing';

  const form = document.getElementById('estimate') as HTMLFormElement | null;
  if (form) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const sqft = $<HTMLInputElement>('sqft');
    const range = $<HTMLInputElement>('sqft-range');
    const washrooms = $<HTMLInputElement>('washrooms');
    const kitchens = $<HTMLInputElement>('kitchens');
    const visitsField = $<HTMLFieldSetElement>('visits-field');
    const label = $('result-label');
    const price = $('result-price');
    const per = $('result-per');
    const rows = $('result-rows');

    const row = (term: string, value: string) => {
      const div = document.createElement('div');
      const dt = document.createElement('dt');
      const dd = document.createElement('dd');
      dt.textContent = term;
      dd.textContent = value;
      dd.className = 'num';
      div.append(dt, dd);
      return div;
    };

    const update = () => {
      const area = clampInput(sqft.value, LIMITS.sqft);
      const wash = Math.floor(clampInput(washrooms.value, LIMITS.washrooms));
      const kit = Math.floor(clampInput(kitchens.value, LIMITS.kitchens));
      const kind = (form.elements.namedItem('kind') as RadioNodeList).value;
      const visits = Number((form.elements.namedItem('visits') as RadioNodeList).value) || 5;

      visitsField.hidden = kind === 'deep';

      if (kind === 'deep') {
        label.textContent = 'One-off deep clean';
        price.textContent = formatPounds(deep(area, wash, kit));
        per.textContent = '';
        rows.replaceChildren(
          row('Floor area', `${formatNumber(area)} sq ft`),
          row('Washrooms', formatNumber(wash)),
          row('Kitchens', formatNumber(kit)),
        );
      } else {
        const r = regular(area, wash, kit, visits);
        label.textContent = 'Estimated monthly price';
        price.textContent = formatPounds(r.monthly);
        per.textContent = ' /month';
        rows.replaceChildren(
          row('Time per visit', `${r.hours.toFixed(1)} hours`),
          row('Price per visit', formatPounds(r.perVisit)),
          row('Visits', `${visits} a week`),
          row('Works out at', `£${r.perSqft.toFixed(2)} per sq ft a month`),
        );
      }
    };

    sqft.addEventListener('input', () => {
      const area = clampInput(sqft.value, LIMITS.sqft);
      range.value = String(Math.min(Math.max(area, Number(range.min)), Number(range.max)));
      update();
    });
    sqft.addEventListener('change', () => {
      const area = clampInput(sqft.value, LIMITS.sqft);
      if (sqft.value !== '' && Number(sqft.value) !== area) sqft.value = String(area);
    });
    range.addEventListener('input', () => {
      sqft.value = range.value;
      update();
    });
    form.addEventListener('input', (e) => {
      if (e.target !== sqft && e.target !== range) update();
    });
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }

  const copy = document.getElementById('copy-phone') as HTMLButtonElement | null;
  if (copy) {
    const status = document.getElementById('copy-status')!;
    const numberEl = document.getElementById('talk-phone')!;
    const original = copy.textContent;
    let timer: number | undefined;
    copy.addEventListener('click', async () => {
      const value = copy.dataset.phone ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        // Fallback: select the number so the visitor can copy it themselves.
        const range = document.createRange();
        range.selectNodeContents(numberEl);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = 'Number selected';
      }
      if (copied) {
        copy.textContent = 'Copied';
        status.textContent = 'Number copied';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          copy.textContent = original;
          status.textContent = '';
        }, 2500);
      }
    });
  }
</script>

<style>
  .estimate-band {
    padding-top: 0;
  }
  .estimate {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 900px) {
    .estimate {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .side {
      position: sticky;
      top: 96px;
    }
  }
  .estimate-form {
    display: grid;
    gap: var(--space-4);
    padding: 26px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  fieldset[hidden] {
    display: none;
  }
  legend {
    padding: 0;
    margin-bottom: 6px;
  }
  .pair {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 520px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .range {
    width: 100%;
    margin: 8px 0 0;
    min-height: 44px;
    accent-color: var(--highland);
    cursor: pointer;
  }
  @media (prefers-color-scheme: dark) {
    .range {
      accent-color: var(--on-brand-muted);
    }
  }
  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    background: var(--sage);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .segmented label {
    flex: 1 1 0;
    position: relative;
    display: flex;
  }
  .segmented input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .segmented span {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.25;
    text-align: center;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .segmented input:checked + span {
    background: var(--card);
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--highland);
  }
  @media (prefers-color-scheme: dark) {
    .segmented input:checked + span {
      box-shadow: inset 0 0 0 1.5px var(--on-brand-muted);
    }
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--saffron);
    outline-offset: 2px;
  }

  .result {
    display: grid;
    gap: var(--space-4);
    background: var(--highland);
    color: var(--on-brand);
    border-radius: var(--radius-md);
    padding: 28px;
  }
  .result-live {
    display: grid;
    gap: var(--space-3);
  }
  .result-label {
    color: var(--on-brand-muted);
  }
  .result-price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(44px, 6vw, 60px);
    line-height: 1;
  }
  .per {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 19px;
    color: var(--on-brand-muted);
  }
  .result-rows {
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .result-rows :global(div) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
    font-size: 16px;
  }
  .result-rows :global(dt) {
    color: var(--on-brand-muted);
  }
  .result-rows :global(dd) {
    font-weight: 700;
    text-align: right;
  }
  .result-note {
    color: var(--on-brand-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .below {
    align-items: start;
  }
  .talk-phone {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.2;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .trust .chip {
    min-height: 36px;
    font-size: 14.5px;
    font-weight: 700;
  }
</style>
