---
import Base from '../layouts/Base.astro';

const buildings = [
  'Offices',
  'Schools and education centres',
  'Churches',
  'Shops and business units',
  'Gyms and sports facilities',
  'Factories and warehouses',
  'Communal areas',
  'Car parks',
];
---
<Base
  title="About Us · Llama Commercial"
  heading="About Us"
  description="Llama Commercial is a London cleaning company. Calm, steady, background-checked cleaners who do what's written down."
>
  <section class="block">
    <p>
      Llama Commercial is a London cleaning company with one simple idea: you shouldn't have to think about your cleaning. It just
      gets done.
    </p>
    <p>Llamas are calm, steady and hard-working. So are we. No fuss, just steady work, week after week.</p>
    <p>Anyone who cleans for us is background-checked before they set foot in your building.</p>
    <p>Before we start, we write down what gets cleaned, how often and when. You get a copy, and that's what we do.</p>
    <p>We use professional kit, the right product for each surface, and greener products where they do the job just as well.</p>
  </section>
  <section class="block">
    <h2>Buildings we look after</h2>
    <ul class="ticks">
      {buildings.map((b) => <li>{b}</li>)}
    </ul>
  </section>
  <section class="block">
    <p class="note">Vetted cleaners. Fully insured. Llama handle it.</p>
  </section>
</Base>
