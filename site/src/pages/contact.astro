---
import Base from '../layouts/Base.astro';
import { SITE, telHref, mailHref } from '../config';
---
<Base
  title="Contact Us · Llama Commercial"
  heading="Contact Us"
  description="Call or email Llama Commercial about cleaning your building."
>
  <section class="block">
    <p class="phone-line">Telephone: <a class="strong-link underline-accent" href={telHref}>{SITE.phone}</a></p>
    <p>
      The quickest way is a call. Prefer to write? Email <a class="strong-link email" href={mailHref}>{SITE.email}</a> and tell us
      about your building.
    </p>
  </section>
</Base>

<style>
  .phone-line {
    font-size: 20px;
    color: var(--ink);
  }
  .email {
    overflow-wrap: anywhere;
  }
</style>
