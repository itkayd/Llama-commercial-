---
import Base from '../layouts/Base.astro';
const postcodes = ['N', 'NW', 'E', 'EC', 'W', 'WC', 'SW', 'SE', 'SM', 'CR', 'BR'];
---
<Base
  title="Areas Covered · Llama Commercial"
  heading="Areas Covered"
  description="Llama Commercial cleans in these London postcode areas: N, NW, E, EC, W, WC, SW, SE, SM, CR and BR."
>
  <section class="block">
    <p class="lead">Our llamas get around. We clean in these London postcode areas:</p>
    <ul class="chips">
      {postcodes.map((p) => <li>{p}</li>)}
    </ul>
  </section>
</Base>
